# ==============================================================================
# CampusBoost Smart Contract Environment Variables (Testnet / Mainnet)
# ==============================================================================
# คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env (ห้าม commit .env ขึ้น GitHub เด็ดขาด!)

# 1. Private Key ของกระเป๋าที่จะใช้ Deploy Contract (เช่น จาก MetaMask)
# คำเตือน: ใช้กระเป๋าสำหรับทดสอบ (Testnet Wallet) เท่านั้น ห้ามใส่กระเป๋าเงินจริงที่มีสินทรัพย์เยอะ
DEPLOYER_PRIVATE_KEY=YOUR_TESTNET_PRIVATE_KEY

# 2. ที่อยู่กระเป๋าที่จะให้รับค่าธรรมเนียมแพลตฟอร์ม 2% (Fee Recipient Address)
PLATFORM_FEE_RECIPIENT=0xF2De54C27Ba6b0A1Fe6c96B79adC40beb21136Cd

# 3. RPC URL สำหรับเชื่อมต่อบล็อกเชน (สามารถสมัครรับฟรีได้จาก Alchemy หรือ Infura)
# ตัวอย่างเครือข่าย Base Sepolia (Chain ID: 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# หรือจาก Alchemy: https://base-sepolia.g.alchemy.com/v2/ใส่_ALCHEMY_API_KEY_ตรงนี้

# ตัวอย่างเครือข่าย Polygon Amoy (Chain ID: 80002)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# 4. API Key สำหรับ Verify Source Code บน Block Explorer (Etherscan / Basescan) (ไม่บังคับ)
BASESCAN_API_KEY=ใส่_BASESCAN_API_KEY_ตรงนี้_ถ้าต้องการ_Verify_สัญญา
